POSTGRES_DB=discord_anthropologist
POSTGRES_USER=discord
POSTGRES_PASSWORD=discord
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

DATABASE_URL=postgresql://discord:discord@127.0.0.1:5433/discord_anthropologist

# Legacy single provider: whisper, speechmatics or deepgram.
# New installs use remote providers in this order. Leave order empty for legacy mode.
TRANSCRIPTION_PROVIDER_ORDER=deepgram,speechmatics
TRANSCRIPTION_PROVIDER=whisper

WHISPER_MODEL=large-v3
# Use cpu without an NVIDIA driver. Use cuda to enable docker-compose.gpu.yml via make.
WHISPER_DEVICE=cpu
# Keep Portuguese fixed for Discord calls. Set auto to let Whisper detect the language.
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=10
WHISPER_INITIAL_PROMPT=
WHISPER_CARRY_INITIAL_PROMPT=false
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_HALLUCINATION_SILENCE_THRESHOLD=2.0
WHISPER_MAX_NO_SPEECH_PROB=0.8
WHISPER_NUM_THREADS=0
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
PYTORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu126

# Deepgram secrets live only in the Python API. Keys share project quotas.
DEEPGRAM_API_KEY=
DEEPGRAM_API_KEY_01=
DEEPGRAM_API_KEY_02=
DEEPGRAM_API_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_REALTIME_URL=wss://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=pt-PT
DEEPGRAM_KEYTERMS=
DEEPGRAM_ENDPOINTING_MS=500
# Optional project IDs for management. Unknown keys share a conservative group.
DEEPGRAM_PROJECT_ID=
DEEPGRAM_PROJECT_ID_02=
# Local ceilings, not a claim about the account's granted quota.
DEEPGRAM_STREAMING_LIMIT=150
DEEPGRAM_BATCH_LIMIT=50
# Optional suffix overrides: DEEPGRAM_STREAMING_LIMIT_02=1, DEEPGRAM_BATCH_LIMIT_02=1

# Used when TRANSCRIPTION_PROVIDER=speechmatics.
SPEECHMATICS_API_KEY=your_speechmatics_api_key
SPEECHMATICS_API_KEY_01=
SPEECHMATICS_API_KEY_02=
SPEECHMATICS_API_KEY_03=
SPEECHMATICS_BATCH_URL=https://eu1.asr.api.speechmatics.com/v2
SPEECHMATICS_LANGUAGE=multi
SPEECHMATICS_MODEL=melia-1
SPEECHMATICS_POLLING_INTERVAL_SECONDS=2
SPEECHMATICS_TIMEOUT_SECONDS=600
SPEECHMATICS_SEGMENT_GAP_SECONDS=1.5
SPEECHMATICS_ADDITIONAL_VOCAB=
# Initial mode only; /streaming persists an override per Discord server.
TRANSCRIPTION_STREAMING_ENABLED=false
# Print partial/final text in API terminal logs. Keep off for normal operation.
TRANSCRIPTION_STREAMING_DEBUG=false
# Realtime is separate from Batch melia-1/multi and assumes Portuguese speech.
SPEECHMATICS_REALTIME_URL=wss://eu.rt.speechmatics.com/v2/
SPEECHMATICS_REALTIME_MODEL=enhanced
SPEECHMATICS_REALTIME_LANGUAGE=pt
# Optional hours budget for /keys percentages. This is NOT provider credits/quota.
# 0 = show hours without an invented percentage. Period defaults to current UTC month.
SPEECHMATICS_USAGE_LIMIT_HOURS=0
# Optional start date (YYYY-MM-DD) for a custom/lifetime budget.
SPEECHMATICS_USAGE_SINCE=

UPLOAD_TMP_DIR=.tmp/uploads
RECORDINGS_DIR=discord_bot/recordings
# Completed audio is deleted after its transcript is committed. Sweep interval:
RECORDING_CLEANUP_INTERVAL_SECONDS=60

# Discord Developer Portal: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token
DISCORD_APP_ID=your_discord_application_id
# Minutes before the bot leaves the call and starts processing. Use 0 to disable.
BOT_LEAVE=60
TRANSCRIPTION_API_URL=http://localhost:8000
# Backend request deadline; reads are capped at 30s and recording admission at 20s.
API_REQUEST_TIMEOUT=5m
# Audio slices reduce silence costs and make transcripts available during the call.
RECORDING_IDLE_SECONDS=10
RECORDING_MAX_SECONDS=300
# Hey Bot speech-energy threshold in S16LE RMS; tune during the Discord trial.
ASSISTANT_SPEECH_RMS=500
# Continuous silence from the question's author before closing it (0.5–20 seconds).
ASSISTANT_SILENCE_SECONDS=5
# Local Portuguese speech plus chat replies. Set false for chat only.
ASSISTANT_VOICE_ENABLED=true
# Living memory: one closed time window per bulk, last 1-3 bulks for callbacks.
GROUP_MEMORY_ENABLED=true
GROUP_MEMORY_BULK_MINUTES=5
GROUP_MEMORY_CONTEXT_BULKS=3
GROUP_MEMORY_REACTIONS_ENABLED=true
GROUP_MEMORY_REACTION_COOLDOWN_MINUTES=10
# Optional meme GIF search; never send the Discord token to GIPHY.
GIPHY_API_KEY=
SESSION_SUMMARY_TIMEOUT=30m
SESSION_SUMMARY_POLL_INTERVAL=5s
BOT_LANGUAGE=pt

# LLM provider: openai, groq, ollama, or chatgpt (ChatGPT account OAuth).
LLM_PROVIDER=openai
# With chatgpt, run make codex to open the official ChatGPT login.
# See CHATGPT_SETUP.md for VM/SSH instructions. No OPENAI_API_KEY is needed.
CHATGPT_ADMIN_PASSWORD=
CHATGPT_REDIRECT_URI=http://127.0.0.1:1455/auth/callback
CHATGPT_AUTH_FILE=.tmp/chatgpt/auth.json
# Optional initial model slug; leave empty to choose from your account catalog.
CHATGPT_MODEL=
# Model-dependent: default, none, minimal, low, medium, high, xhigh, max.
# /effort level:low tests and persists a runtime override. default uses the model default.
CHATGPT_REASONING_EFFORT=medium
# Each provider request has a deadline; hosted SDK retries once on transient failures.
LLM_TIMEOUT_SECONDS=90
# Evidence above this size is distilled in ordered slices, then combined.
LLM_CONTEXT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=2500
# Remote transcription workers (1–8); local Whisper always uses one worker.
TRANSCRIPTION_WORKERS=2
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: use these values when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: local LLM configuration when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:2b

PROFILE_DOCS_PROVIDER=local
LOCAL_PROFILE_DIR=/app/profiles

TEXT_PROFILE_SYNC_ENABLED=true
TEXT_PROFILE_SYNC_INTERVAL_HOURS=12
